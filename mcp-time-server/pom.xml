<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.vidocq.tools</groupId>
        <artifactId>lc4jcdi-on-vidocq-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-time-server</artifactId>
    <packaging>jar</packaging>

    <name>LC4JCDI on Vidocq: MCP Time Server</name>
    <description>A langchain4j-cdi MCP server (two tools, a resource template and a prompt, all about IANA time
        zones) hosted on the Vidocq runtime suite (Vauban CDI 4.1 Lite + Cassini Jakarta REST + Chappe HTTP).
        Requires JDK 25, which the Vidocq 0.4.0-SNAPSHOT artifacts and Maven plugin are compiled for
        (class file version 69).</description>

    <properties>
        <!-- Read by vidocq:generate / vidocq:package, which are bound below. -->
        <vidocq.mainModule>io.vidocq.tools.lc4jcdi.mcptimeserver</vidocq.mainModule>
        <vidocq.mainClass>io.vidocq.tools.lc4jcdi.mcptimeserver.McpTimeServerApp</vidocq.mainClass>
    </properties>

    <dependencies>
        <!--
            The only MCP dependency. The Vidocq extension brings langchain4j-cdi's MCP server and its optional
            CDI 4.1 invoker, the Jakarta REST runtime that serves /mcp, and a generated vauban-beans.list that
            indexes the server's beans, so this application declares none of them.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-langchain4j-cdi-mcp-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>

        <!-- Vidocq runtime -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Tool/Prompt/ResourceTemplate argument names are bound by parameter name, not by index. -->
                    <parameters>true</parameters>
                    <!--
                        The Vauban and Cassini annotation processors, referenced as the jars that the
                        vidocq-runtime-core-codegen and vidocq-runtime-cassini-rest-extension-codegen aggregates
                        depend on. Those aggregates are published as POMs only, and IntelliJ's Maven import asks for
                        a jar for every processor path whatever its <type>: the resolution fails without a word,
                        the module gets no processor path, and IntelliJ's build never runs the processors. Maven
                        puts the same processor jars on javac's processor path either way.

                        Keep BuildCompatibleExtension jars (cassini-cdi-vauban, for instance) off this path: an
                        extension that runs here leaves META-INF/vauban-bce-processed in target/classes, and
                        vidocq:generate then stops rescanning this module, so it no longer repairs the bean index
                        before an IDE launch (README.md, "Running from an IDE").
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.cassini</groupId>
                            <artifactId>cassini-processor</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <version>${vidocq.version}</version>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>package</id>
                        <goals>
                            <goal>package</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
