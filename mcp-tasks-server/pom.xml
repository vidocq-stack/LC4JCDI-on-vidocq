<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.vidocq.tools</groupId>
        <artifactId>lc4jcdi-on-vidocq-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-tasks-server</artifactId>
    <packaging>jar</packaging>

    <name>LC4JCDI on Vidocq: MCP Tasks Server</name>
    <description>A task tracker on an H2 file database: Mansart pool, Mansart Data repositories and Mansart
        transactions behind a Cassini REST API that writes, and a langchain4j-cdi MCP server that reads. Hosted on
        the Vidocq runtime suite (Vauban CDI 4.1 Lite + Cassini Jakarta REST + Chappe HTTP). Requires JDK 25, which
        the Vidocq 0.4.0-SNAPSHOT artifacts and Maven plugin are compiled for (class file version 69).</description>

    <properties>
        <!-- Read by vidocq:generate / vidocq:package, which are bound below, and by vidocq:dev. -->
        <vidocq.mainModule>io.vidocq.tools.lc4jcdi.mcptasks</vidocq.mainModule>
        <vidocq.mainClass>io.vidocq.tools.lc4jcdi.mcptasks.McpTasksServerApp</vidocq.mainClass>
        <!--
            vidocq:dev opens a JDWP agent on 5005 unless told otherwise. This module keeps every port it opens in
            18090-18099, so a forgotten -Dvidocq.dev.debugPort never lands on a port something else uses.
            -Dvidocq.dev.debugPort=... on the command line still overrides it.
        -->
        <vidocq.dev.debugPort>18091</vidocq.dev.debugPort>
    </properties>

    <dependencies>
        <!--
            The only MCP dependency. The Vidocq extension brings langchain4j-cdi's MCP server and its optional
            CDI 4.1 invoker, the Jakarta REST runtime that serves /mcp, and a generated vauban-beans.list that
            indexes the server's beans, so this application declares none of them.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-langchain4j-cdi-mcp-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>

        <!-- Vidocq runtime -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-indexer</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
            <version>${vidocq.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            Mansart: the @Default DataSource (a connection pool configured by vidocq.pool.*), Jakarta Data
            repositories generated at compile time, and JTA transactions (@Transactional, TransactionManager).
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-pool-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-data-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-transactions-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <!-- The SQL dialect, found through ServiceLoader. -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-dialect-h2</artifactId>
            <version>${vidocq.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- The JDBC driver; also on the test class path for TaskRepositoryTest. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>runtime</scope>
        </dependency>
        <!-- @Entity, @Table, @Column... : annotations only, Mansart is the implementation. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!--
            Schema migrations at boot (priority 150, before the pool): Flyway applies db/migration to the
            @Default datasource, using the vidocq.pool.url/username/password coordinates. The Flyway backend
            also brings flyway-core, which TaskRepositoryTest uses directly.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-migration-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-flyway-migration-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Tool/Prompt/ResourceTemplate argument names are bound by parameter name, not by index. -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.cassini</groupId>
                            <artifactId>cassini-processor</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.mansart</groupId>
                            <artifactId>mansart-data-processor</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.mansart</groupId>
                            <artifactId>mansart-data-cdi</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.mansart</groupId>
                            <artifactId>mansart-transactions-cdi</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        The tests boot Mansart standalone, Flyway and H2 in memory, as Mansart's own tests do, on the
                        class path. The JPMS boot of the whole application is exercised by vidocq:dev, run.sh and
                        the repository's end-to-end script, not by these unit tests.
                    -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <version>${vidocq.version}</version>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>package</id>
                        <goals>
                            <goal>package</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
