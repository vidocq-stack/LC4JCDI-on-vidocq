<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.vidocq.tools</groupId>
        <artifactId>lc4jcdi-on-vidocq-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-tasks-server</artifactId>
    <packaging>jar</packaging>

    <name>LC4JCDI on Vidocq: MCP Tasks Server</name>
    <description>A task tracker on an H2 file database: Mansart pool, Mansart Data repositories and Mansart
        transactions behind a Cassini REST API that writes, and a langchain4j-cdi MCP server that reads. Hosted on
        the Vidocq runtime suite (Vauban CDI 4.1 Lite + Cassini Jakarta REST + Chappe HTTP). Requires JDK 25, which
        the Vidocq 0.4.0-SNAPSHOT artifacts and Maven plugin are compiled for (class file version 69).</description>

    <properties>
        <!-- Read by vidocq:generate / vidocq:package, which are bound below, and by vidocq:dev. -->
        <vidocq.mainModule>io.vidocq.tools.lc4jcdi.mcptasks</vidocq.mainModule>
        <vidocq.mainClass>io.vidocq.tools.lc4jcdi.mcptasks.McpTasksServerApp</vidocq.mainClass>
        <!--
            vidocq:dev opens a JDWP agent on 5005 unless told otherwise. This module keeps every port it opens in
            18090-18099, so a forgotten -Dvidocq.dev.debugPort never lands on a port something else uses.
            -Dvidocq.dev.debugPort=... on the command line still overrides it.
        -->
        <vidocq.dev.debugPort>18091</vidocq.dev.debugPort>
    </properties>

    <dependencies>
        <!-- langchain4j-cdi's MCP server. -->
        <dependency>
            <groupId>dev.langchain4j.cdi.mcp</groupId>
            <artifactId>langchain4j-cdi-mcp-server</artifactId>
            <version>${lc4jcdi.version}</version>
        </dependency>

        <!--
            Optional reflection-free invocation, as in mcp-time-server. run.sh re-layers this jar into app/
            alongside the MCP server (see run.sh for why).
        -->
        <dependency>
            <groupId>dev.langchain4j.cdi.mcp</groupId>
            <artifactId>langchain4j-cdi-mcp-invoker-cdi41</artifactId>
            <version>${lc4jcdi.version}</version>
        </dependency>

        <!-- Vidocq runtime -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-indexer</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
            <version>${vidocq.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            Mansart: the @Default DataSource (a connection pool configured by vidocq.pool.*), Jakarta Data
            repositories generated at compile time, and JTA transactions (@Transactional, TransactionManager).
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-pool-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-data-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-transactions-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <!--
            The JDBC side of Mansart transactions. mansart-data-cdi enlists a repository's connection in the
            current JTA transaction only when io.vidocq.mansart.transactions.jdbc.ConnectionXAResource loads
            (JtaBridgeActivator); otherwise every repository call autocommits on its own and @Transactional
            rolls nothing back. mansart-data-cdi declares this artifact optional, and none of the three
            extensions above brings it, so it is declared here.
        -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-transactions-jdbc</artifactId>
            <version>${vidocq.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- The SQL dialect, found through ServiceLoader. -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-dialect-h2</artifactId>
            <version>${vidocq.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- The JDBC driver; also on the test class path for TaskRepositoryTest. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>runtime</scope>
        </dependency>
        <!-- @Entity, @Table, @Column... : annotations only, Mansart is the implementation. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!--
            Schema migrations at boot (priority 150, before the pool): Flyway applies db/migration to the
            @Default datasource, using the vidocq.pool.url/username/password coordinates. The Flyway backend
            also brings flyway-core, which TaskRepositoryTest uses directly.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-migration-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-flyway-migration-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>

        <!--
            The dev console: a read-only page on a loopback listener of its own (vidocq.devconsole.port, 18092 in
            vidocq.properties), on in a dev launch only (vidocq:dev, an IDE, -Dvidocq.launch.mode=dev). Its
            "Mansart pools" tab shows this application's @Default pool live: active and idle connections out of
            maxSize, borrows per second, the password as "configured" only. An ordinary dependency: no codegen
            bundle, no requires in module-info.

            It comes, for now, from a LOCAL install of Vidocq (branch feat/91-devconsole-slice1): the snapshots
            repository has neither this artifact nor a pool extension that feeds its panel (README.md, "The
            snapshot dependencies"). Build with -nsu, so that a newer remote pool extension without the panel
            never replaces the local one.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-devconsole-extension</artifactId>
            <version>${vidocq.version}</version>
        </dependency>

        <!--
            Jakarta APIs: Cassini is Jakarta REST 4.0, Vauban is CDI 4.1 Lite, so 4.1.0 (not the jakartaee-bom 10
            4.0.1 that langchain4j-cdi-mcp-server compiles against) is required here.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>4.1.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.lang-model</artifactId>
            <version>4.1.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <version>2.2.0</version>
        </dependency>
        <!-- io.vidocq.vauban.core requires the jakarta.el module. -->
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <version>6.0.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <version>2.1.3</version>
        </dependency>
        <dependency>
            <groupId>jakarta.json.bind</groupId>
            <artifactId>jakarta.json.bind-api</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.7</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse</groupId>
            <artifactId>yasson</artifactId>
            <version>3.0.4</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Tool/Prompt/ResourceTemplate argument names are bound by parameter name, not by index. -->
                    <parameters>true</parameters>
                    <compilerArgs>
                        <!--
                            Vauban's build-time bean index is built from the packages a scanned dependency
                            EXPORTS; the cross-module bean index that actually resolves beans living in a
                            dependency jar (McpToolRegistry, McpPromptRegistry, McpResourceRegistry and their
                            transport-package collaborators) is only produced later, by vidocq:generate
                            (process-classes). Bean-resolution validation therefore has to be deferred to the
                            runtime container, where it succeeds. Vauban's own warning suggests this flag.
                        -->
                        <arg>-Avauban.validation=false</arg>
                    </compilerArgs>
                    <!--
                        Every processor is referenced as a jar, not through the *-codegen aggregates, which are
                        published as POMs only: IntelliJ's Maven import asks for a jar for every processor path
                        whatever its <type>, fails without a word, and then never runs the processors. Maven puts
                        the same jars on javac's processor path either way.

                        - vauban-processor, cassini-processor: what vidocq-runtime-core-codegen and
                          vidocq-runtime-cassini-rest-extension-codegen bring.
                        - mansart-data-processor, mansart-data-cdi: what vidocq-runtime-mansart-data-extension-codegen
                          brings. The processor generates TaskRepositoryImpl and the entity metamodels.
                        - mansart-transactions-cdi: what vidocq-runtime-mansart-transactions-extension-codegen brings.

                        Unlike mcp-time-server, this path does hold BuildCompatibleExtension jars (mansart-data-cdi,
                        mansart-transactions-cdi): Mansart needs them at build time. The trade-off is that they
                        leave META-INF/vauban-bce-processed in target/classes, after which vidocq:generate still
                        indexes the scanned MCP server jar but no longer rescans this module's own classes, so it
                        cannot repair an IDE-built bean index before an IDE launch (README.md, "Running from an
                        IDE"). Both Mansart extensions are written to run again at runtime, where Vauban keeps the
                        full extension lifecycle on for the unprocessed MCP server classes.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.cassini</groupId>
                            <artifactId>cassini-processor</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.mansart</groupId>
                            <artifactId>mansart-data-processor</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.mansart</groupId>
                            <artifactId>mansart-data-cdi</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.mansart</groupId>
                            <artifactId>mansart-transactions-cdi</artifactId>
                            <version>${vidocq.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        The tests boot Mansart standalone, Flyway and H2 in memory, as Mansart's own tests do, on the
                        class path. The JPMS boot of the whole application is exercised by vidocq:dev, run.sh and
                        the repository's end-to-end script, not by these unit tests.
                    -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <version>${vidocq.version}</version>
                <!--
                    McpEndpoint and the whole MCP server live in a dependency jar that Vauban's APT never saw, so its
                    CDI beans have to be indexed (and client-proxied) at build time from the outside.

                    Deliberately at plugin level, not on the "generate" execution: a goal run on its own
                    (`mvn vidocq:generate`, or an IDE "Before launch" step) uses the default-cli execution, which
                    does not inherit an execution's configuration. See https://codefloe.com/Vidocq/vidocq/issues/83
                -->
                <configuration>
                    <scanDependencies>
                        <scanDependency>dev.langchain4j.cdi.mcp:langchain4j-cdi-mcp-server</scanDependency>
                    </scanDependencies>
                </configuration>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>package</id>
                        <goals>
                            <goal>package</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
